# Clearhold Environment Variables
# Copy this file to .env.local and fill in the values

# Supabase Configuration
# Get these from: https://supabase.com/dashboard/project/[your-project]/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Gemini API Key
# Get this from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key

# Stripe Configuration
# Get these from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Stripe Webhook Secret
# Get this after creating a webhook endpoint in Stripe Dashboard
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Price ID
# Create a $1/month subscription product in Stripe and get the Price ID
STRIPE_PRICE_ID=price_...

# App URL (for Stripe redirects)
# Use http://localhost:3000 for local dev, your production URL for deployment
NEXT_PUBLIC_APP_URL=http://localhost:3000
